<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- keep benchmark output readable: framework internals quiet unless debugging -->
    <logger name="org.redisson" level="WARN"/>
    <logger name="io.github.cuihairu.redis.streaming" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
